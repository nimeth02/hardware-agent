# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# ── Secrets / machine-local configuration ─────────────────────────────
.env

# ── Live SQLite stores (held open by the dev server) ──────────────────
observability/*.db
observability/*.db-journal
checkpoints/

# ── Agent outputs ─────────────────────────────────────────────────────
runs/

# ── Example projects: keep the hand-written sources, drop tool output ──
projects/*/work_proj/
projects/*/impl_out/
projects/*/scripts/
projects/*/constraints/
# project folders generated by the orchestrator (<entity>_<timestamp>)
projects/*_20[0-9][0-9][0-9][0-9][0-9][0-9]_*/

# ── Vivado / xsim / MATLAB leftovers ──────────────────────────────────
*.jou
*.log
*.pb
*.wdb
*.vcd
*.str
xsim.dir/
.Xil/
webtalk*
*.dcp
*.rpt

# ── Third-party reference code (170 MB, not part of the product) ──────
reference/

