# ── Example projects: keep the hand-written sources, drop tool output ──
projects/*/work_proj/
projects/*/impl_out/
projects/*/scripts/
projects/*/constraints/
# project folders generated by the orchestrator / pipeline runs.
# Three naming schemes have been used over time:
#   <entity>_<YYYYMMDD>_<HHMMSS>/        (first version)
#   <YYYYMMDD>_<HHMMSS>_<requirement>/   (second version)
#   <requirement>_T-hh.mm_D-dd.mm.yyyy/  (current, agents/orchestrator_agent/requirement_id.py)
# Only hand-written examples (projects/counter4/) are committed.
projects/*_20[0-9][0-9][0-9][0-9][0-9][0-9]_*/
projects/20[0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9]_*/
projects/*_T-[0-9][0-9].[0-9][0-9]_D-[0-9][0-9].[0-9][0-9].[0-9][0-9][0-9][0-9]/

# ── Vivado / xsim / MATLAB leftovers ──────────────────────────────────
*.jou
*.log
*.pb
*.wdb
*.vcd
*.str
xsim.dir/
.Xil/
webtalk*
*.dcp
*.rpt

# ── Third-party reference code (170 MB, not part of the product) ──────
reference/
references/

