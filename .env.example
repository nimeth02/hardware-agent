# Copy to .env and fill in for your machine. .env is git-ignored.

# ── LLM provider: change this ONE line to switch ───────────────────────
# ollama     = local Ollama server (uses OLLAMA_API_BASE + LLM_MODEL)
# openrouter = cloud (uses OPENROUTER_API_KEY + OPENROUTER_MODEL)
LLM_PROVIDER=ollama

# ── Ollama (local LLM, OpenAI-compatible API) ──────────────────────────
OLLAMA_API_BASE=http://localhost:11434
LLM_MODEL=qwen3-coder-next

# ── OpenRouter (cloud) ─────────────────────────────────────────────────
OPENROUTER_API_BASE=https://openrouter.ai/api
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b
# off = answer directly (seconds); on = let the model think first (minutes per call)
OPENROUTER_REASONING=off

# Seconds one AI request may take before it gives up (any provider)
LLM_TIMEOUT_SECONDS=300

# ── Vivado (local install; settings64.sh is sourced through Git Bash) ──
VIVADO_SETTINGS64=C:/Xilinx/Vivado/2020.1/settings64.sh
VIVADO_VERSION_PINNED=2020.1
# Target part for synthesis/implementation (default: Basys 3 Artix-7)
# VIVADO_PART=xc7a35tcpg236-1

# ── Vivado on another machine over SSH (optional; mcp_servers/vivado_env.py) ──
# Leave VIVADO_REMOTE_HOST empty to use the local install above.
# Remote mode needs `pip install paramiko`.
# VIVADO_REMOTE_HOST=
# VIVADO_REMOTE_USER=
# VIVADO_REMOTE_PASSWORD=          # leave blank to use key auth
# VIVADO_REMOTE_KEY=               # path to an SSH private key (optional)
# VIVADO_REMOTE_SETTINGS64=/tools/Xilinx/Vivado/2020.1/settings64.sh

# ── MATLAB engine startup options (mcp_servers/matlab_server/matlab_server.py) ──
# MATLAB_STARTUP_OPTIONS=-nodesktop
